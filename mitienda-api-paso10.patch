new file mode 100644
index 0000000..1185620
--- /dev/null
+++ b/src/inventario.js
@@ -0,0 +1,72 @@
+import { FieldValue } from "firebase-admin/firestore";
+import { db } from "./firebase.js";
+import { ErrorApi } from "./errores.js";
+
+export const TIPOS_MOVIMIENTO = ["entrada", "salida"];
+const CANTIDAD_MAXIMA = 100000;
+
+/* Valida y normaliza el cuerpo de POST /inventario/movimientos. */
+export function validarMovimiento(cuerpo = {}) {
+  const { producto_id, tipo, cantidad, motivo } = cuerpo || {};
+
+  if (typeof producto_id !== "string" || !producto_id.trim() || producto_id.includes("/")) {
+    throw new ErrorApi(400, "Falta producto_id.");
+  }
+  if (!TIPOS_MOVIMIENTO.includes(tipo)) {
+    throw new ErrorApi(400, "Tipo de movimiento no válido (entrada o salida).");
+  }
+  if (!Number.isInteger(cantidad) || cantidad <= 0) {
+    throw new ErrorApi(400, "La cantidad debe ser un número entero mayor que 0.");
+  }
+  if (cantidad > CANTIDAD_MAXIMA) {
+    throw new ErrorApi(400, `La cantidad no puede superar ${CANTIDAD_MAXIMA}.`);
+  }
+
+  const motivoLimpio = typeof motivo === "string" ? motivo.trim().slice(0, 100) : "";
+  return {
+    productoId: producto_id.trim(),
+    tipo,
+    cantidad,
+    motivo: motivoLimpio || "Sin especificar",
+  };
+}
+
+/* REGISTRAR MOVIMIENTO MANUAL (antes en js/services/inventario.js)
+   Cambia el stock y crea el movimiento en una sola transacción: o se guardan los dos o ninguno.
+   El negocio sale del usuario autenticado, no del cuerpo. */
+export async function registrarMovimiento({ productoId, tipo, cantidad, motivo, negocioId }) {
+  const firestore = db();
+  const productoRef = firestore.collection("productos").doc(productoId);
+  const movimientoRef = firestore.collection("movimientos_inventario").doc();
+
+  const stock = await firestore.runTransaction(async (tx) => {
+    const snap = await tx.get(productoRef);
+    if (!snap.exists) throw new ErrorApi(404, "El producto no existe.");
+
+    const producto = snap.data();
+    if (producto.negocio_id !== negocioId) {
+      throw new ErrorApi(403, "El producto pertenece a otro negocio.");
+    }
+
+    const stockActual = Number(producto.stock) || 0;
+    if (tipo === "salida" && cantidad > stockActual) {
+      throw new ErrorApi(409, `No hay suficiente stock disponible. Disponible: ${stockActual}.`);
+    }
+
+    const nuevoStock = tipo === "entrada" ? stockActual + cantidad : stockActual - cantidad;
+
+    tx.update(productoRef, { stock: nuevoStock });
+    tx.set(movimientoRef, {
+      producto_id: productoId,
+      negocio_id: negocioId,
+      tipo,
+      cantidad,
+      motivo,
+      fecha: FieldValue.serverTimestamp(),
+    });
+
+    return nuevoStock;
+  });
+
+  return { movimiento_id: movimientoRef.id, stock };
+}
diff --git a/test/inventario.test.js b/test/inventario.test.js
new file mode 100644
index 0000000..be1495d
--- /dev/null
+++ b/test/inventario.test.js
@@ -0,0 +1,57 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { crearApp } from "../src/app.js";
+import { validarMovimiento } from "../src/inventario.js";
+import { ErrorApi } from "../src/errores.js";
+
+let servidor;
+let base;
+
+before(async () => {
+  servidor = crearApp().listen(0);
+  await new Promise((r) => servidor.once("listening", r));
+  base = `http://127.0.0.1:${servidor.address().port}`;
+});
+
+after(() => servidor.close());
+
+test("POST /inventario/movimientos sin token devuelve 401", async () => {
+  const res = await fetch(`${base}/inventario/movimientos`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ producto_id: "p1", tipo: "entrada", cantidad: 5 }),
+  });
+  assert.equal(res.status, 401);
+});
+
+test("validarMovimiento normaliza un movimiento válido", () => {
+  const r = validarMovimiento({ producto_id: " p1 ", tipo: "salida", cantidad: 3, motivo: "  Merma  " });
+  assert.deepEqual(r, { productoId: "p1", tipo: "salida", cantidad: 3, motivo: "Merma" });
+});
+
+test("validarMovimiento usa «Sin especificar» si no hay motivo", () => {
+  assert.equal(validarMovimiento({ producto_id: "p1", tipo: "entrada", cantidad: 1 }).motivo, "Sin especificar");
+});
+
+test("validarMovimiento recorta el motivo a 100 caracteres", () => {
+  const r = validarMovimiento({ producto_id: "p1", tipo: "entrada", cantidad: 1, motivo: "x".repeat(300) });
+  assert.equal(r.motivo.length, 100);
+});
+
+for (const [nombre, cuerpo] of [
+  ["sin producto_id", { tipo: "entrada", cantidad: 1 }],
+  ["producto_id con barra", { producto_id: "a/b", tipo: "entrada", cantidad: 1 }],
+  ["tipo desconocido", { producto_id: "p1", tipo: "ajuste", cantidad: 1 }],
+  ["cantidad cero", { producto_id: "p1", tipo: "entrada", cantidad: 0 }],
+  ["cantidad negativa", { producto_id: "p1", tipo: "salida", cantidad: -2 }],
+  ["cantidad decimal", { producto_id: "p1", tipo: "entrada", cantidad: 1.5 }],
+  ["cantidad como texto", { producto_id: "p1", tipo: "entrada", cantidad: "5" }],
+  ["cantidad enorme", { producto_id: "p1", tipo: "entrada", cantidad: 1e9 }],
+]) {
+  test(`validarMovimiento rechaza ${nombre} con 400`, () => {
+    assert.throws(
+      () => validarMovimiento(cuerpo),
+      (e) => e instanceof ErrorApi && e.estado === 400
+    );
+  });
+}
