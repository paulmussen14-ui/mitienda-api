# Copia este archivo como .env (NO lo subas a GitHub)
PORT=8080
# desarrollo | produccion (aparece en los logs y en las métricas)
AMBIENTE=desarrollo
FIREBASE_PROJECT_ID=mitienda-ee0e8
# Contenido completo del JSON de la cuenta de servicio de Firebase, en una sola línea.
FIREBASE_SERVICE_ACCOUNT_JSON=
CORS_ORIGINS=https://mitienda-ee0e8.web.app,http://localhost:8080
# true = solo clientes registrados (no anónimos) pueden crear pedidos
EXIGIR_CLIENTE_REGISTRADO=false
# Token de 48 caracteres (por ejemplo: openssl rand -hex 24). Debe ser IGUAL en Render y en el scrape job de Grafana. No pongas aquí el token real.
METRICS_TOKEN=REEMPLAZAR_CON_UN_TOKEN_DE_48_CARACTERES